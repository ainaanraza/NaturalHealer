# Server-only secrets. Set these in Vercel > Project > Settings > Environment Variables,
# and in a local .env for `npm run dev:api`. None of these may start with VITE_,
# because Vite copies VITE_ variables into the public JavaScript bundle.

# Google AI Studio key for Gemini (create a new one; the old VITE_ key was public)
GEMINI_API_KEY=

# Optional, defaults to gemini-3.8-flash (gemini-2.5-flash has been retired for new keys)
# GEMINI_MODEL=gemini-3.8-flash

# Firebase Admin: Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the whole JSON on one line (or base64 of it):
FIREBASE_SERVICE_ACCOUNT=
# ...or the three fields separately:
# FIREBASE_PROJECT_ID=naturalhealer
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
